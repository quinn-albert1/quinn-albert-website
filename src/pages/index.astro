---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { buildPhotoData } from '../lib/photos';

const { sections, allGalleryPhotos } = buildPhotoData();
const hasPhotos = allGalleryPhotos.length > 0;

// Shuffle gallery photos (Fisher-Yates, runs at build time)
const galleryPhotos = [...allGalleryPhotos];
for (let i = galleryPhotos.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [galleryPhotos[i], galleryPhotos[j]] = [galleryPhotos[j], galleryPhotos[i]];
}

// Videos
let videos = site.featuredVideos.map(v => ({ id: v.id, title: v.title }));
if (site.youtubeChannelId) {
  try {
    const res = await fetch(
      `https://www.youtube.com/feeds/videos.xml?channel_id=${site.youtubeChannelId}`
    );
    const xml = await res.text();
    const entries = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)];
    const parsed = entries.slice(0, 8).map(entry => {
      const id    = entry[1].match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1] ?? '';
      const raw   = entry[1].match(/<title>(.*?)<\/title>/)?.[1] ?? '';
      const title = raw.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"');
      return { id, title };
    }).filter(v => v.id);
    if (parsed.length > 0) videos = parsed;
  } catch { /* fallback */ }
}

// Fetch missing titles from YouTube oEmbed (no API key needed)
videos = await Promise.all(
  videos.map(async v => {
    if (v.title) return v;
    try {
      const r = await fetch(
        `https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${v.id}&format=json`
      );
      const data = await r.json() as { title?: string };
      return { ...v, title: data.title ?? '' };
    } catch {
      return v;
    }
  })
);
---

<Layout title="Quinn Albert" description="Photographer & filmmaker — Quinn Albert">

  <!-- NAV -->
  <nav class="site-nav" id="nav" aria-label="Site navigation">
    <a href="/" class="nav-logo">Quinn Albert</a>
    <ul class="nav-links" role="list">
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#explore">Explore</a></li>
      <li><a href="#videos">Videos</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <ul class="nav-social" role="list" aria-label="Social links">
      <li>
        <a href={site.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </li>
      <li>
        <a href={site.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        </a>
      </li>
    </ul>

    <button class="nav-hamburger" id="nav-hamburger" aria-label="Open navigation" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
      <ul role="list">
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#explore">Explore</a></li>
        <li><a href="#videos">Videos</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <main id="main">

    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-name">
      {site.heroVideos.length > 0 && (
        <div class="hero-video-bg" aria-hidden="true">
          {site.heroVideos.map((src, i) => (
            <video
              class={`hero-video${i === 0 ? ' is-active' : ''}`}
              data-index={String(i)}
              muted
              playsinline
              preload={i === 0 ? 'auto' : 'none'}
            >
              <source src={src} />
            </video>
          ))}
        </div>
      )}
      <h1 class="hero-name" id="hero-name">Quinn Albert</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-scroll" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </section>

    <!-- GALLERY: curated gallery-tagged photos -->
    <section id="gallery" aria-labelledby="gallery-heading">
      <div class="photos-header">
        <p class="section-label">Photos</p>
        <h2 id="gallery-heading">Gallery</h2>
      </div>

      {hasPhotos ? (
        <div class="photo-grid home-gallery" id="photo-grid">
          {galleryPhotos.map((photo, i) => (
            <button
              class="photo-item"
              data-src={photo.url}
              data-alt="Gallery"
              aria-label="View photo"
            >
              <img src={photo.url} alt="Gallery photo" loading={i < 6 ? 'eager' : 'lazy'} />
            </button>
          ))}
        </div>
      ) : (
        <div class="photo-empty"><p>Photos coming soon.</p></div>
      )}
    </section>

    <!-- EXPLORE: location cards -->
    <section id="explore" aria-labelledby="explore-heading">
      <div class="photos-header">
        <p class="section-label">Explore</p>
        <h2 id="explore-heading">By destination</h2>
      </div>

      {sections.length > 0 ? (
        <div class="locations-block">
          <div class="location-cards">
            {sections.map(section => (
              <a
                href={`/photos/${section.slug}`}
                class="location-card"
                aria-label={`View all ${section.name} photos`}
              >
                {section.previewUrl && (
                  <img
                    src={section.previewUrl}
                    alt={section.name}
                    loading="lazy"
                    class="location-card-img"
                  />
                )}
                <div class="location-card-overlay" aria-hidden="true"></div>
                <div class="location-card-label">
                  <span class="location-card-name">{section.name}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="photo-empty"><p>Destinations coming soon.</p></div>
      )}
    </section>

    <!-- LIGHTBOX -->
    <dialog class="lightbox" id="lightbox" aria-label="Photo lightbox">
      <div class="lightbox-inner">
        <button class="lightbox-close" id="lightbox-close" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
        <img class="lightbox-img" id="lightbox-img" src="" alt="" />
        {site.formspreeId && (
          <div class="lightbox-footer">
            <button class="print-inquiry-btn" id="print-inquiry-btn">Interested in a print?</button>
          </div>
        )}
      </div>
    </dialog>

    <!-- PRINT INQUIRY DIALOG -->
    {site.formspreeId && (
      <dialog class="print-dialog" id="print-dialog" aria-label="Request a print">
        <div class="print-dialog-inner">
          <button class="print-dialog-close" id="print-dialog-close" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
          <img class="print-dialog-thumb" id="print-dialog-thumb" src="" alt="" />
          <h2 class="print-dialog-heading">Request a print</h2>
          <p class="print-dialog-sub">I'll get back to you with sizes, pricing, and options.</p>
          <form id="print-form" method="POST" action={`https://formspree.io/f/${site.formspreeId}`}>
            <input type="hidden" name="photo_url" id="print-photo-input" />
            <div class="form-field">
              <label for="print-name">Name</label>
              <input type="text" id="print-name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-field">
              <label for="print-email">Email</label>
              <input type="email" id="print-email" name="email" required placeholder="you@example.com" />
            </div>
            <div class="form-field">
              <label for="print-message">Message <span class="form-optional">(optional)</span></label>
              <textarea id="print-message" name="message" rows="3" placeholder="Size preference, questions…"></textarea>
            </div>
            <button type="submit" class="print-submit-btn">Send inquiry</button>
          </form>
          <p class="print-success" id="print-success" hidden>Thanks! I'll be in touch soon.</p>
        </div>
      </dialog>
    )}

    <!-- VIDEOS -->
    <section id="videos" aria-labelledby="videos-heading">
      <div class="videos-header">
        <p class="section-label">Videos</p>
        <h2 id="videos-heading">Watch</h2>
      </div>
      <div class="video-grid">
        {videos.map(video => (
          <div class="video-thumb" data-id={video.id} role="button" tabindex="0"
               aria-label={video.title ? `Play: ${video.title}` : 'Play video'}>
            <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                 alt={video.title || 'YouTube video'} loading="lazy" />
            {video.title && (
              <div class="video-title" aria-hidden="true">{video.title}</div>
            )}
            <div class="play-overlay" aria-hidden="true">
              <div class="play-btn">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" aria-labelledby="contact-heading">
      <div class="contact-inner">
        <p class="section-label">Contact</p>
        <h2 id="contact-heading">Say hello</h2>
        <div class="contact-btns">
          <a href={`mailto:${site.email}`} class="email-btn" aria-label="Send an email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Send an email
          </a>
          {site.formspreeId && (
            <button class="print-contact-btn" id="contact-print-btn" aria-label="Request a print">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
                <path d="M4 16v4h16v-4M8 12l4 4 4-4M12 3v13"/>
              </svg>
              Request a print
            </button>
          )}
        </div>
        <ul class="social-row" role="list" aria-label="Social media links">
          <li>
            <a href={site.socials.youtube} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
            </a>
          </li>
          <li>
            <a href={site.socials.instagram} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <p>&copy; <span id="year"></span> Quinn Albert &mdash; No trackers. No ads.</p>
    <p class="footer-contact">
      <a href="mailto:quinnalbert1@gmail.com">quinnalbert1@gmail.com</a>
      <span aria-hidden="true">&middot;</span>
      <a href="tel:+17813664736">781-366-4736</a>
    </p>
  </footer>

  <script>
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    // Hero background video cycling + glitch restart on full loop
    const heroVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('.hero-video'));
    if (heroVideos.length > 0) {
      let current = 0;
      let playedCount = 0;
      const glitchEls = [
        document.querySelector<HTMLElement>('.hero-name'),
        document.querySelector<HTMLElement>('.hero-tagline'),
      ].filter((el): el is HTMLElement => el !== null);

      const triggerGlitch = () => {
        glitchEls.forEach(el => {
          el.style.animation = 'none';
          void el.offsetHeight;
          el.style.animation = '';
        });
      };

      const preloadNext = (idx: number) => {
        const next = heroVideos[(idx + 1) % heroVideos.length];
        if (next.preload === 'none') {
          next.preload = 'auto';
          next.load();
        }
      };

      const advance = () => {
        const prev = current;
        current = (current + 1) % heroVideos.length;

        heroVideos[current].classList.add('is-active');
        heroVideos[current].currentTime = 0;
        heroVideos[current].play().catch(() => advance()); // skip unplayable clips

        setTimeout(() => heroVideos[prev].classList.remove('is-active'), 1000);

        preloadNext(current);

        playedCount++;
        if (playedCount >= heroVideos.length) {
          playedCount = 0;
          triggerGlitch();
        }
      };

      if (heroVideos.length === 1) {
        heroVideos[0].loop = true;
        heroVideos[0].play().catch(() => {});
      } else {
        heroVideos.forEach(vid => {
          vid.addEventListener('ended', advance);
          vid.addEventListener('error', advance); // skip broken/unsupported clips
        });
        preloadNext(0);
        heroVideos[0].play().catch(() => {});
      }
    }

    const nav = document.getElementById('nav');
    if (nav) {
      const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('nav-mobile-menu');
    if (hamburger && nav && mobileMenu) {
      hamburger.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('nav-open');
        hamburger.setAttribute('aria-expanded', String(isOpen));
        mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      });
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('nav-open');
          hamburger.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        });
      });
    }

    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    if (dialog && lightboxImg) {
      document.querySelectorAll<HTMLElement>('.photo-item').forEach(item => {
        item.addEventListener('click', () => {
          lightboxImg.src = item.dataset.src ?? '';
          lightboxImg.alt = item.dataset.alt ?? '';
          dialog.showModal();
        });
        item.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); item.click(); }
        });
      });
      document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e: MouseEvent) => { if (e.target === dialog) dialog.close(); });
    }

    // Print inquiry
    const printDialog = document.getElementById('print-dialog') as HTMLDialogElement | null;
    const printForm = document.getElementById('print-form') as HTMLFormElement | null;
    const printPhotoInput = document.getElementById('print-photo-input') as HTMLInputElement | null;
    const printThumb = document.getElementById('print-dialog-thumb') as HTMLImageElement | null;
    const printSuccess = document.getElementById('print-success') as HTMLElement | null;

    document.getElementById('print-inquiry-btn')?.addEventListener('click', () => {
      if (printPhotoInput) printPhotoInput.value = lightboxImg?.src ?? '';
      if (printThumb) { printThumb.src = lightboxImg?.src ?? ''; printThumb.alt = lightboxImg?.alt ?? ''; printThumb.hidden = false; }
      if (printForm) printForm.style.display = '';
      if (printSuccess) printSuccess.hidden = true;
      dialog?.close();
      printDialog?.showModal();
    });

    document.getElementById('print-dialog-close')?.addEventListener('click', () => printDialog?.close());
    printDialog?.addEventListener('click', (e: MouseEvent) => { if (e.target === printDialog) printDialog.close(); });

    document.getElementById('contact-print-btn')?.addEventListener('click', () => {
      if (printPhotoInput) printPhotoInput.value = '';
      if (printThumb) { printThumb.src = ''; printThumb.hidden = true; }
      if (printForm) printForm.style.display = '';
      if (printSuccess) printSuccess.hidden = true;
      printDialog?.showModal();
    });

    printForm?.addEventListener('submit', async (e: SubmitEvent) => {
      e.preventDefault();
      const res = await fetch(printForm.action, {
        method: 'POST',
        body: new FormData(printForm),
        headers: { Accept: 'application/json' },
      }).catch(() => null);
      if (res?.ok) {
        printForm.style.display = 'none';
        if (printSuccess) printSuccess.hidden = false;
      }
    });

    document.querySelectorAll<HTMLElement>('.video-thumb').forEach(thumb => {
      const activate = () => {
        const id = thumb.dataset.id;
        if (!id) return;
        const wrap = document.createElement('div');
        wrap.className = 'video-iframe-wrapper';
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        wrap.appendChild(iframe);
        thumb.replaceWith(wrap);
      };
      thumb.addEventListener('click', activate);
      thumb.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    });
  </script>

</Layout>
